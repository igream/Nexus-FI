# ==============================================================================
# CONFIGURACIÓN DE VARIABLES DE ENTORNO SEGREGADAS - NEXUS FI (UAEMéx)
# Permite auditar y generar reportes de consumo de tokens y costos por separado.
# NUNCA subas el archivo .env a GitHub o a ningún repositorio público.
# ==============================================================================

# 1. API Key exclusiva para Embeddings (text-embedding-3-small, 1536 dimensiones)
OPENAI_API_KEY_EMBEDDINGS=sk-proj-tu-key-para-embeddings-aqui

# 2. API Key exclusiva para Chat en Producción (GPT-4o-mini para respuestas RAG)
OPENAI_API_KEY_CHAT_4O_MINI=sk-proj-tu-key-para-chat-4o-mini-aqui

# 3. API Keys para Experimentación y Benchmarking (Modelos Luna)
OPENAI_API_KEY_GPT6_LUNA=sk-proj-tu-key-para-gpt6-luna-aqui
OPENAI_API_KEY_GPT5_6_LUNA=sk-proj-tu-key-para-gpt5-6-luna-aqui

# Clave de respaldo general (Fallback para compatibilidad legacy)
OPENAI_API_KEY=sk-proj-tu-key-general-aqui

# Google Gemini API Key (Opcional: diagnósticos alternativos)
GEMINI_API_KEY=tu-gemini-api-key-aqui

# AWS Credentials (Para sincronización de corpus y almacenamiento en S3)
AWS_ACCESS_KEY_ID=tu-aws-access-key-id
AWS_SECRET_ACCESS_KEY=tu-aws-secret-access-key
AWS_REGION=us-east-1
S3_BUCKET_NAME=nexus-fi-corpus-bucket

# Configuración del Servidor Web / API REST
HOST=127.0.0.1
PORT=8000
DEBUG=True

# Subredes institucionales autorizadas FI UAEMéx (WBS 1.3.5 - separadas por coma)
# NUNCA publicar subredes reales en repositorios públicos; configurar en .env local
AUTHORIZED_SUBNETS=10.0.0.0/24,192.168.1.0/24
