# ==============================================================================
# CONFIGURACIÓN DE VARIABLES DE ENTORNO - NEXUS FI (UAEMéx)
# Copia este archivo como .env y coloca tus credenciales correspondientes.
# NUNCA subas el archivo .env a GitHub o a ningún repositorio público.
# ==============================================================================

# OpenAI API Key (Para embeddings text-embedding-3-small y generación RAG con GPT)
OPENAI_API_KEY=tu-openai-api-key-aqui

# Google Gemini API Key (Opcional: diagnósticos y fallback de modelos)
GEMINI_API_KEY=tu-gemini-api-key-aqui

# AWS Credentials (Para sincronización y almacenamiento en Amazon S3)
AWS_ACCESS_KEY_ID=tu-aws-access-key-id
AWS_SECRET_ACCESS_KEY=tu-aws-secret-access-key
AWS_REGION=us-east-1
S3_BUCKET_NAME=nexus-fi-corpus-bucket

# Configuración del Servidor Web / API REST
HOST=127.0.0.1
PORT=8000
DEBUG=True
