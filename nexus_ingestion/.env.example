# Configuración Nexus FI - Ingesta y Embeddings

# OpenAI API Key (Obligatorio para generar embeddings text-embedding-3-small)
OPENAI_API_KEY=tu_api_key_aqui

# Modelo de Embeddings y Dimensiones (WBS 1.3.2)
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Parámetros de Segmentación (RF08)
CHUNK_SIZE_TOKENS=650
CHUNK_OVERLAP_TOKENS=100

# Calibración Anti-Alucinaciones (RF13)
SIMILARITY_THRESHOLD=0.52

# Motor de OCR para PDFs escaneados: "local" (Ryzen 9 / RapidOCR) o "aws_textract"
OCR_PROVIDER=local

# Configuración LanceDB y S3
# Para desarrollo local:
LANCEDB_URI=./data/lancedb
# Para producción en AWS:
# LANCEDB_URI=s3://nexus-fi-vectors/lancedb
LANCEDB_TABLE_NAME=nexus_documents

# AWS Credentials (solo si se usa S3 directo o AWS Textract)
AWS_REGION=us-east-1
S3_BUCKET_NAME=nexus-fi-vectors
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
